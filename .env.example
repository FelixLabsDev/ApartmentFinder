# Database
DATABASE_PATH=data/apartmentfinder.db

# Scraping intervals (minutes)
YAD2_INTERVAL_MINUTES=30
FB_INTERVAL_MINUTES=60

# HTTP settings
REQUEST_TIMEOUT=30
MAX_RETRIES=3
SCRAPE_DELAY_MIN=3.0
SCRAPE_DELAY_MAX=10.0

# Facebook authentication (required for GraphQL scraping)
# Copy your Cookie header from a logged-in Facebook session in browser DevTools:
#   1. Open facebook.com/marketplace in Chrome while logged in
#   2. Open DevTools > Network tab > find any request to facebook.com
#   3. Copy the Cookie header value and paste it here
FB_COOKIES=
# LSD token (found in page source or request payloads)
FB_LSD_TOKEN=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Proxy (optional)
PROXY_URL=

# Debug mode
DEBUG=false

# Green API (WhatsApp integration)
# Sign up at https://green-api.com and create an instance to get these
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
